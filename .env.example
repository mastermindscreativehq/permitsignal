SERPAPI_API_KEY="your-serpapi-key-here"

# CORS origins for the backend API (backend/app/main.py).
# Comma-separated list of allowed frontend origins.
# Local development defaults to http://localhost:3000 when unset.
# Production: set to the actual deployed frontend URL(s).
PERMITSIGNAL_CORS_ORIGINS="http://localhost:3000"

# Lead Intelligence persistence (backend/app/services/lead_repository.py).
# Optional: the pipeline runs and writes its JSON output normally without
# these. Only required to use --sync-supabase / sync_to_supabase=True.
# Apply supabase/migrations/0001_create_leads_table.sql once before use.
SUPABASE_URL=
SUPABASE_KEY=
# Optional override; defaults to "leads".
SUPABASE_LEADS_TABLE=
